# 권장: 브라우저가 아니라 서버 환경변수에 저장
OPENAI_API_KEY=sk-your-key-here

# 공개 Render 주소에서 남이 내 API를 쓰지 못하게 하는 개인 잠금 토큰 (강력 권장)
APP_TOKEN=replace-with-a-long-random-string

# gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol
DEFAULT_MODEL=gpt-5.6-luna

# 프론트/백엔드가 같은 주소면 그대로 두면 됨. 별도 호스팅 시 허용 origin을 쉼표로 지정 가능
ALLOWED_ORIGINS=*
